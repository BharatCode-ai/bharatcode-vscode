        "bharatcode-agent.model.providerID": {
          "type": "string",
          "default": "bharatcode",
          "description": "Default model provider ID for new sessions"
        },
        "bharatcode-agent.model.modelID": {
          "type": "string",
          "default": "qwen-3.8-27b",
          "description": "Default model ID for new sessions"
        },
        "bharatcode-agent.agentManager.autoBranchNaming": {
          "type": "boolean",
          "default": true,
          "scope": "application",
          "description": "Automatically name new Agent Manager branches when the conversation describes a clear task. Explicitly named and published branches are never renamed."
        },
        "bharatcode-agent.agentManager.branchPrefix": {
          "type": "string",
          "default": "",
          "scope": "application",
          "description": "Prefix for automatically named Agent Manager branches, for example 'marius/' or 'feature/'. Explicit branch names are unchanged."
        },
        "bharatcode-agent.agentManager.worktreePool": {
          "type": "boolean",
          "default": true,
          "scope": "application",
          "description": "Pre-warm a ready worktree in the background so new Agent Manager sessions start faster. Uses extra disk space equal to one checkout per open project. Turn off to create worktrees only on demand."
        },
        "bharatcode-agent.experimental.browserAutomation": {
          "type": "boolean",
          "default": false,
          "scope": "application",
          "description": "Enable the experimental Integrated Browser panel and browser_open tool in Agent Manager."
        },
        "bharatcode-agent.experimental.conversationPromptHistory": {
          "type": "boolean",
          "default": false,
          "scope": "application",
          "description": "Keep the prompt input history (ArrowUp/ArrowDown recall) separate for each conversation instead of sharing one history across all conversations."
        },
        "bharatcode-agent.experimental.claudeMigration": {
          "type": "boolean",
          "default": false,
          "scope": "application",
          "description": "Experimental one-time import of supported global Claude Code instructions, simple skills, and disabled MCP definitions into BharatCode. The original Claude files are never changed."
        },
        "bharatcode-agent.agentManager.terminalButtonDestination": {
          "type": "string",
          "scope": "application",
          "default": "agentManager",
          "enum": [
            "vscode",
            "agentManager"
          ],
          "enumDescriptions": [
            "Open or focus the VS Code integrated terminal.",
            "Open or focus an embedded terminal in the Agent Manager side panel."
          ],
          "description": "Default destination for the Agent Manager terminal button and Focus Terminal keyboard shortcut. The terminal button's dropdown remembers its own choice per Agent Manager panel; this setting only applies to panels that never picked one."
        },
        "bharatcode-agent.indexing.showButtonWhenDisabled": {
          "type": "boolean",
          "default": true,
          "scope": "application",
          "description": "Show the codebase indexing button below the prompt while indexing is disabled."
        },
        "bharatcode-agent.claudeCodeCompat": {
          "type": "boolean",
          "default": false,
          "description": "Load CLAUDE.md instructions and skills from your Claude Code configuration directory into BharatCode sessions. Enable this if you want BharatCode to use your Claude Code instructions and skills."
        },
        "bharatcode-agent.extraCaCerts": {
          "type": "string",
          "default": "",
          "description": "Absolute path to a PEM file containing extra CA certificates to trust when the BharatCode backend makes HTTPS requests (sets NODE_EXTRA_CA_CERTS on the CLI process). Use this if you're behind a corporate proxy that performs SSL inspection. Leave empty to rely on the OS trust store."
        },
        "bharatcode-agent.autoApprove.enabled": {
          "type": "boolean",
          "default": false,
          "description": "Start BharatCode with the main auto-approve toggle enabled. When enabled, permission prompts are approved automatically. Sandbox escalation prompts are always excluded."
        },
        "bharatcode-agent.maxCost": {
          "type": "number",
          "default": 0,
          "minimum": 0,
          "description": "Show a non-blocking alert when a session exceeds this USD amount. Use whole dollars; set to 0 to disable."
        },
        "bharatcode-agent.fontSize": {
          "type": "number",
          "default": 13,
          "minimum": 10,
          "maximum": 24,
          "description": "Font size in pixels for the BharatCode webview UI."
        },
        "bharatcode-agent.browserAutomation.enabled": {
          "type": "boolean",
          "default": false,
          "description": "Enable browser automation powered by Playwright. When enabled, the AI agent can interact with web pages in a visible Chrome window."
        },
        "bharatcode-agent.browserAutomation.useSystemChrome": {
          "type": "boolean",
          "default": true,
          "description": "Use your system's installed Chrome browser instead of downloading a separate Chromium instance."
        },
        "bharatcode-agent.browserAutomation.headless": {
          "type": "boolean",
          "default": false,
          "description": "Run browser automation in headless mode (no visible window). When disabled, you can watch the agent interact with the browser."
        },
        "bharatcode-agent.agentManager.browser.useSystemChrome": {
          "type": "boolean",
          "default": true,
          "scope": "application",
          "description": "Use system-installed Google Chrome for the Integrated Browser. Disable only when a compatible Playwright Chromium browser is already installed."
        },
        "bharatcode-agent.agentManager.browser.openLinksIn": {
          "type": "string",
          "enum": [
            "external",
            "integrated"
          ],
          "enumDescriptions": [
            "Open web links in your default browser.",
            "Open web links in a browser tab from the sidebar, or in the browser panel from Agent Manager."
          ],
          "default": "integrated",
          "scope": "application",
          "description": "Choose where web links open from BharatCode chats. Requires the experimental Integrated Browser."
        },
        "bharatcode-agent.attention.enabled": {
          "type": "boolean",
          "default": false,
          "description": "Play sounds when sessions complete, error, or need input"
        },
        "bharatcode-agent.attention.notifications": {
