        "bharatcode-agent.showShortcutHints": {
          "type": "boolean",
          "default": true,
          "description": "Show the keyboard shortcut that fits what you do now in the empty prompt, for example how to add selected code or return to the prompt."
        },
        "bharatcode-agent.showTokenThroughput": {
          "type": "boolean",
          "default": true,
