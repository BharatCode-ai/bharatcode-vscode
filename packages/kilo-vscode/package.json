        },
        "bharatcode-agent.agentManager.pushFixes": {
          "type": "boolean",
          "default": true,
          "description": "Agent Manager: when you send pull request CI failures or review comments to the agent, or update a worktree from its base, ask the agent to commit and push so the pull request updates. Permission prompts still apply. Disable to keep commits manual."
        },
        "bharatcode-agent.agentWorkStyle": {
          "type": "string",
          "scope": "application",
          "default": "unset",
          "enum": [
            "unset",
            "human-in-the-loop",
            "autonomous",
            "skipped"
          ],
          "enumDescriptions": [
            "Show work style onboarding so you can choose again",
            "Human in the Loop: review agent actions as they happen",
            "High autonomy: let BharatCode take most actions with fewer interruptions",
            "Onboarding was skipped without changing work style settings"
          ],
          "description": "Preferred agent work style. Set to Unset to show the onboarding flow again."
        },
        "bharatcode-agent.diff.renderMarkdown": {
          "type": "boolean",
          "default": false,
          "description": "Render Markdown files in BharatCode diff viewers by default. Toggle this from a Markdown file header in the diff viewer."
        },
        "bharatcode-agent.diff.style": {
          "type": "string",
          "enum": [
            "unified",
            "split"
          ],
          "description": "Remembered unified/split choice for BharatCode diff viewers. Set automatically the first time you toggle the style in a diff viewer."
        }
      }
