{
  "name": "bharatcode-agent",
  "displayName": "BharatCode Agent",
  "description": "The VS Code extension for BharatCode (bharatcode.ai). Sign in and the agent runs - the provider, endpoint and models are configured for you, so there is nothing to set up by hand.",
  "version": "7.8.114",
  "icon": "assets/icons/logo-outline-black.png",
  "galleryBanner": {
    "color": "#111113",
    "theme": "dark"
  },
  "publisher": "bharatcode",
  "repository": {
    "type": "git",
    "url": "https://github.com/BharatCode-ai/bharatcode-vscode",
    "directory": "packages/kilo-vscode"
  },
  "homepage": "https://github.com/BharatCode-ai/bharatcode-vscode",
  "bugs": {
    "url": "https://github.com/BharatCode-ai/bharatcode-vscode/issues"
  },
  "engines": {
    "vscode": "^1.105.1"
  },
  "license": "MIT",
  "author": {
    "name": "BharatCode"
  },
  "categories": [
    "AI",
    "Chat",
    "Programming Languages",
    "Education",
    "Snippets",
    "Testing"
  ],
  "keywords": [
    "bharatcode",
    "bharatcode.ai",
    "ai",
    "pair programming",
    "chat",
    "terminal",
    "ai agent",
    "llm",
    "inference",
    "openai-compatible"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onUri"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "configurationDefaults": {
      "files.watcherExclude": {
        "**/.kilo/worktrees/**": true,
        "**/.kilocode/worktrees/**": true
      }
    },
    "taskDefinitions": [
      {
        "type": "bharatcode-agent.worktree-setup",
        "properties": {
          "script": {
            "type": "string",
            "description": "The setup script command to execute"
          },
          "worktree": {
            "type": "string",
            "description": "The worktree directory the setup script runs in"
          }
        }
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "bharatcode-agent.ActivityBar",
          "title": "BharatCode",
          "icon": "assets/icons/kilo-light.png",
          "darkIcon": "assets/icons/kilo-dark.png"
        }
      ]
    },
    "views": {
      "bharatcode-agent.ActivityBar": [
        {
          "type": "webview",
          "id": "bharatcode-agent.SidebarProvider",
          "name": "BharatCode"
        }
      ]
    },
    "commands": [
      {
        "command": "bharatcode-agent.setBharatcodeKey",
        "title": "Sign In",
        "category": "BharatCode"
      },
      {
        "command": "bharatcode-agent.plusButtonClicked",
        "title": "New Task",
        "category": "BharatCode",
        "icon": "$(add)"
      },
      {
        "command": "bharatcode-agent.closeTask",
        "title": "Close Task",
        "category": "BharatCode"
      },
      {
        "command": "bharatcode-agent.closeAllTasks",
        "title": "Close All Tasks",
        "category": "BharatCode"
      },
      {
        "command": "bharatcode-agent.agentManagerOpen",
        "title": "Agent Manager",
        "category": "BharatCode",
        "icon": "$(organization)"
      },
      {
        "command": "bharatcode-agent.marketplaceButtonClicked",
        "title": "Marketplace",
        "category": "BharatCode",
        "icon": "$(extensions)"
      },
      {
        "command": "bharatcode-agent.historyButtonClicked",
        "title": "History",
        "category": "BharatCode",
        "icon": "$(history)"
      },
      {
        "command": "bharatcode-agent.profileButtonClicked",
        "title": "Profile",
        "category": "BharatCode",
        "icon": "$(account)"
      },
      {
        "command": "bharatcode-agent.settingsButtonClicked",
        "title": "Settings",
        "category": "BharatCode",
        "icon": "$(settings-gear)"
      },
      {
        "command": "bharatcode-agent.settingsSearch",
        "title": "Search Settings",
        "category": "BharatCode",
        "icon": "$(search)"
      },
      {
        "command": "bharatcode-agent.sidebarTitle.plusButtonClicked",
        "title": "New Task",
        "icon": "$(add)"
      },
      {
        "command": "bharatcode-agent.sidebarTitle.agentManagerOpen",
        "title": "Agent Manager",
        "icon": "$(organization)"
      },
      {
        "command": "bharatcode-agent.sidebarTitle.marketplaceButtonClicked",
        "title": "Marketplace",
        "icon": "$(extensions)"
      },
      {
        "command": "bharatcode-agent.sidebarTitle.historyButtonClicked",
        "title": "History",
        "icon": "$(history)"
      },
      {
        "command": "bharatcode-agent.sidebarTitle.profileButtonClicked",
        "title": "Profile",
        "icon": "$(account)"
      },
      {
        "command": "bharatcode-agent.sidebarTitle.settingsButtonClicked",
        "title": "Settings",
        "icon": "$(settings-gear)"
      },
      {
        "command": "bharatcode-agent.openInTab",
        "title": "Open in Tab",
        "category": "BharatCode",
        "icon": {
          "light": "assets/icons/kilo-light.svg",
          "dark": "assets/icons/kilo-dark.svg"
        }
      },
      {
        "command": "bharatcode-agent.openBrowser",
        "title": "Open Integrated Browser",
        "category": "BharatCode",
        "icon": "$(globe)"
      },
      {
        "command": "bharatcode-agent.showChanges",
        "title": "Show Changes",
        "category": "BharatCode"
      },
      {
        "command": "bharatcode-agent.showMemory",
        "title": "Show Project Memory",
        "category": "BharatCode"
      },
      {
        "command": "bharatcode-agent.toggleMemory",
        "title": "Toggle Project Memory",
        "category": "BharatCode"
      },
      {
        "command": "bharatcode-agent.toggleCaffeination",
        "title": "Toggle Keep Awake",
        "category": "BharatCode"
      },
      {
        "command": "bharatcode-agent.agentManager.previousSession",
        "title": "Agent Manager: Previous Session",
        "category": "BharatCode"
      },
      {
        "command": "bharatcode-agent.agentManager.nextSession",
        "title": "Agent Manager: Next Session",
        "category": "BharatCode"
      },
      {
        "command": "bharatcode-agent.agentManager.previousTab",
        "title": "Previous Session Tab",
        "category": "BharatCode"
      },
      {
        "command": "bharatcode-agent.agentManager.nextTab",
        "title": "Next Session Tab",
        "category": "BharatCode"
      },
      {
        "command": "bharatcode-agent.agentManager.previousTerminal",
        "title": "Agent Manager: Previous Terminal",
        "category": "BharatCode"
      },
      {
        "command": "bharatcode-agent.agentManager.nextTerminal",
        "title": "Agent Manager: Next Terminal",
        "category": "BharatCode"
      },
      {
        "command": "bharatcode-agent.agentManager.diagnostics",
        "title": "Agent Manager: Show Worktree Diagnostics",
        "category": "BharatCode"
      },
      {
        "command": "bharatcode-agent.agentManager.search",
        "title": "Agent Manager: Search Worktrees and Sessions",
        "category": "BharatCode"
      },
      {
        "command": "bharatcode-agent.agentManager.showTerminal",
        "title": "Agent Manager: Focus Terminal",
        "category": "BharatCode",
        "icon": "$(terminal)"
      },
      {
        "command": "bharatcode-agent.agentManager.runScript",
        "title": "Agent Manager: Run Script",
        "category": "BharatCode",
        "icon": "$(play)"
      },
      {
        "command": "bharatcode-agent.agentManager.toggleDiff",
        "title": "Agent Manager: Toggle Diff Panel",
        "category": "BharatCode",
        "icon": "$(diff)"
      },
      {
        "command": "bharatcode-agent.agentManager.showShortcuts",
        "title": "Agent Manager: Show Keyboard Shortcuts",
        "category": "BharatCode",
        "icon": "$(keyboard)"
      },
      {
        "command": "bharatcode-agent.agentManager.newTab",
        "title": "Agent Manager: New Tab",
        "category": "BharatCode"
      },
      {
        "command": "bharatcode-agent.agentManager.newTerminalTab",
        "title": "Agent Manager: New Terminal Tab",
        "category": "BharatCode"
      },
      {
        "command": "bharatcode-agent.agentManager.newSideTerminal",
        "title": "Agent Manager: New Sidebar Terminal Tab",
        "category": "BharatCode"
      },
      {
        "command": "bharatcode-agent.agentManager.closeTab",
        "title": "Agent Manager: Close Tab",
        "category": "BharatCode"
      },
      {
        "command": "bharatcode-agent.agentManager.newWorktree",
        "title": "Agent Manager: Configure New Worktree",
        "category": "BharatCode"
      },
      {
        "command": "bharatcode-agent.agentManager.quickWorktree",
        "title": "Agent Manager: New Worktree",
        "category": "BharatCode"
      },
      {
        "command": "bharatcode-agent.agentManager.openWorktree",
        "title": "Agent Manager: Open Worktree",
        "category": "BharatCode"
      },
      {
        "command": "bharatcode-agent.agentManager.updateFromBase",
        "title": "Agent Manager: Update from base",
        "category": "BharatCode",
        "enablement": "activeWebviewPanelId == 'bharatcode-agent.AgentManagerPanel'"
      },
      {
        "command": "bharatcode-agent.agentManager.openPR",
        "title": "Agent Manager: Open Pull Request",
        "category": "BharatCode"
      },
      {
        "command": "bharatcode-agent.agentManager.closeWorktree",
        "title": "Agent Manager: Close Worktree",
        "category": "BharatCode"
      },
      {
        "command": "bharatcode-agent.agentManager.advancedWorktree",
        "title": "Agent Manager: Configure New Worktree",
        "category": "BharatCode"
      },
      {
        "command": "bharatcode-agent.agentManager.jumpTo1",
        "title": "Agent Manager: Jump to Item 1",
        "category": "BharatCode"
      },
      {
        "command": "bharatcode-agent.agentManager.jumpTo2",
        "title": "Agent Manager: Jump to Item 2",
        "category": "BharatCode"
      },
      {
        "command": "bharatcode-agent.agentManager.jumpTo3",
        "title": "Agent Manager: Jump to Item 3",
        "category": "BharatCode"
      },
      {
        "command": "bharatcode-agent.agentManager.jumpTo4",
        "title": "Agent Manager: Jump to Item 4",
        "category": "BharatCode"
      },
      {
        "command": "bharatcode-agent.agentManager.jumpTo5",
        "title": "Agent Manager: Jump to Item 5",
        "category": "BharatCode"
      },
      {
        "command": "bharatcode-agent.agentManager.jumpTo6",
        "title": "Agent Manager: Jump to Item 6",
        "category": "BharatCode"
      },
      {
        "command": "bharatcode-agent.agentManager.jumpTo7",
        "title": "Agent Manager: Jump to Item 7",
        "category": "BharatCode"
      },
      {
        "command": "bharatcode-agent.agentManager.jumpTo8",
        "title": "Agent Manager: Jump to Item 8",
        "category": "BharatCode"
      },
      {
        "command": "bharatcode-agent.agentManager.jumpTo9",
        "title": "Agent Manager: Jump to Item 9",
        "category": "BharatCode"
      },
      {
        "command": "bharatcode-agent.generateCommitMessage",
        "title": "Generate Commit Message",
        "category": "BharatCode",
        "icon": {
          "light": "assets/icons/kilo-light.svg",
          "dark": "assets/icons/kilo-dark.svg"
        }
      },
      {
        "command": "bharatcode-agent.explainCode",
        "title": "Explain Code",
        "category": "BharatCode"
      },
      {
        "command": "bharatcode-agent.fixCode",
        "title": "Fix Code",
        "category": "BharatCode"
      },
      {
        "command": "bharatcode-agent.improveCode",
        "title": "Improve Code",
        "category": "BharatCode"
      },
      {
        "command": "bharatcode-agent.addToContext",
        "title": "Add to Context",
        "category": "BharatCode"
      },
      {
        "command": "bharatcode-agent.terminalAddToContext",
        "title": "Add Terminal Content to Context",
        "category": "BharatCode"
      },
      {
        "command": "bharatcode-agent.terminalFixCommand",
        "title": "Fix This Command",
        "category": "BharatCode"
      },
      {
        "command": "bharatcode-agent.terminalExplainCommand",
        "title": "Explain This Command",
        "category": "BharatCode"
      },
      {
        "command": "bharatcode-agent.focusChatInput",
        "title": "Focus Chat Input",
        "category": "BharatCode"
      },
      {
        "command": "bharatcode-agent.toggleChatSearch",
        "title": "Toggle Chat Search",
        "category": "BharatCode"
      },
      {
        "command": "bharatcode-agent.cycleAgentMode",
        "title": "Cycle Agent Mode",
        "category": "BharatCode"
      },
      {
        "command": "bharatcode-agent.cyclePreviousAgentMode",
        "title": "Cycle Previous Agent Mode",
        "category": "BharatCode"
      },
      {
        "command": "bharatcode-agent.toggleAutoApprove",
        "title": "Toggle Auto-Approve",
        "category": "BharatCode"
      },
      {
        "command": "bharatcode-agent.generateTerminalCommand",
        "title": "Generate Terminal Command",
        "category": "BharatCode"
      },
      {
        "command": "bharatcode-agent.takeHeapSnapshot",
        "title": "Take Heap Snapshot",
        "category": "BharatCode"
      },
      {
        "command": "bharatcode-agent.reload",
        "title": "Reload Config and Skills",
        "category": "BharatCode"
      }
    ],
    "submenus": [
      {
        "id": "bharatcode-agent.editorContextMenu",
        "label": "BharatCode"
      },
      {
        "id": "bharatcode-agent.terminalContextMenu",
        "label": "BharatCode"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "bharatcode-agent.sidebarTitle.plusButtonClicked",
          "when": "false"
        },
        {
          "command": "bharatcode-agent.sidebarTitle.historyButtonClicked",
          "when": "false"
        },
        {
          "command": "bharatcode-agent.sidebarTitle.agentManagerOpen",
          "when": "false"
        },
        {
          "command": "bharatcode-agent.agentManager.advancedWorktree",
          "when": "false"
        },
        {
          "command": "bharatcode-agent.sidebarTitle.marketplaceButtonClicked",
          "when": "false"
        },
        {
          "command": "bharatcode-agent.sidebarTitle.profileButtonClicked",
          "when": "false"
        },
        {
          "command": "bharatcode-agent.sidebarTitle.settingsButtonClicked",
          "when": "false"
        }
      ],
      "view/title": [
        {
          "command": "bharatcode-agent.sidebarTitle.plusButtonClicked",
          "group": "navigation@0",
          "when": "view == bharatcode-agent.SidebarProvider && !bharatcode-agent.isCursor"
        },
        {
          "command": "bharatcode-agent.sidebarTitle.historyButtonClicked",
          "group": "navigation@1",
          "when": "view == bharatcode-agent.SidebarProvider && !bharatcode-agent.isCursor"
        },
        {
          "command": "bharatcode-agent.sidebarTitle.agentManagerOpen",
          "group": "navigation@2",
          "when": "view == bharatcode-agent.SidebarProvider && !bharatcode-agent.isCursor"
        },
        {
          "command": "bharatcode-agent.sidebarTitle.marketplaceButtonClicked",
          "group": "navigation@3",
          "when": "view == bharatcode-agent.SidebarProvider && !bharatcode-agent.isCursor"
        },
        {
          "command": "bharatcode-agent.sidebarTitle.profileButtonClicked",
          "group": "navigation@4",
          "when": "view == bharatcode-agent.SidebarProvider && !bharatcode-agent.isCursor"
        },
        {
          "command": "bharatcode-agent.sidebarTitle.settingsButtonClicked",
          "group": "navigation@5",
          "when": "view == bharatcode-agent.SidebarProvider && !bharatcode-agent.isCursor"
        }
      ],
      "scm/title": [
        {
          "command": "bharatcode-agent.generateCommitMessage",
          "group": "navigation",
          "when": "scmProvider == git"
        }
      ],
      "scm/input": [
        {
          "command": "bharatcode-agent.generateCommitMessage",
          "group": "navigation",
          "when": "scmProvider == git"
        }
      ],
      "editor/title": [
        {
          "command": "bharatcode-agent.openInTab",
          "group": "navigation",
          "when": "true"
        },
        {
          "command": "bharatcode-agent.plusButtonClicked",
          "group": "navigation@0",
          "when": "activeWebviewPanelId == bharatcode-agent.TabPanel && !bharatcode-agent.isCursor"
        },
        {
          "command": "bharatcode-agent.historyButtonClicked",
          "group": "navigation@1",
          "when": "activeWebviewPanelId == bharatcode-agent.TabPanel && !bharatcode-agent.isCursor"
        },
        {
          "command": "bharatcode-agent.profileButtonClicked",
          "group": "navigation@2",
          "when": "activeWebviewPanelId == bharatcode-agent.TabPanel && !bharatcode-agent.isCursor"
        },
        {
          "command": "bharatcode-agent.settingsButtonClicked",
          "group": "navigation@3",
          "when": "activeWebviewPanelId == bharatcode-agent.TabPanel && !bharatcode-agent.isCursor"
        }
      ],
      "editor/context": [
        {
          "submenu": "bharatcode-agent.editorContextMenu",
          "group": "1_bharatcode-agent"
        }
      ],
      "bharatcode-agent.editorContextMenu": [
        {
          "command": "bharatcode-agent.explainCode",
          "group": "1_actions@1"
        },
        {
          "command": "bharatcode-agent.fixCode",
          "group": "1_actions@2"
        },
        {
          "command": "bharatcode-agent.improveCode",
          "group": "1_actions@3"
        },
        {
          "command": "bharatcode-agent.addToContext",
          "group": "1_actions@4"
        }
      ],
      "terminal/context": [
        {
          "submenu": "bharatcode-agent.terminalContextMenu",
          "group": "2_bharatcode-agent"
        }
      ],
      "bharatcode-agent.terminalContextMenu": [
        {
          "command": "bharatcode-agent.terminalAddToContext",
          "group": "1_actions@1"
        },
        {
          "command": "bharatcode-agent.terminalFixCommand",
          "group": "1_actions@2"
        },
        {
          "command": "bharatcode-agent.terminalExplainCommand",
          "group": "1_actions@3"
        }
      ]
    },
    "keybindings": [
      {
        "command": "bharatcode-agent.focusChatInput",
        "key": "ctrl+shift+a",
        "mac": "cmd+shift+a",
        "when": "bharatcode-agent.sidebarFocused || activeWebviewPanelId == 'bharatcode-agent.AgentManagerPanel' || activeWebviewPanelId == 'bharatcode-agent.TabPanel'"
      },
      {
        "command": "bharatcode-agent.toggleAutoApprove",
        "key": "ctrl+alt+a",
        "mac": "cmd+alt+a",
        "when": "bharatcode-agent.sidebarFocused || activeWebviewPanelId == 'bharatcode-agent.AgentManagerPanel' || activeWebviewPanelId == 'bharatcode-agent.TabPanel'"
      },
      {
        "command": "bharatcode-agent.generateTerminalCommand",
        "key": "ctrl+shift+g",
        "mac": "cmd+shift+g",
        "when": "bharatcode-agent.sidebarFocused || activeWebviewPanelId == 'bharatcode-agent.AgentManagerPanel' || activeWebviewPanelId == 'bharatcode-agent.TabPanel'"
      },
      {
        "command": "bharatcode-agent.agentManagerOpen",
        "key": "ctrl+shift+m",
        "mac": "cmd+shift+m",
        "when": "bharatcode-agent.sidebarFocused || activeWebviewPanelId == 'bharatcode-agent.AgentManagerPanel' || activeWebviewPanelId == 'bharatcode-agent.TabPanel'"
      },
      {
        "command": "bharatcode-agent.addToContext",
        "key": "ctrl+k ctrl+a",
        "mac": "cmd+k cmd+a",
        "when": "editorTextFocus && editorHasSelection"
      },
      {
        "command": "bharatcode-agent.agentManager.previousSession",
        "key": "ctrl+alt+up",
        "mac": "cmd+alt+up",
        "when": "activeWebviewPanelId == 'bharatcode-agent.AgentManagerPanel'"
      },
      {
        "command": "bharatcode-agent.agentManager.nextSession",
        "key": "ctrl+alt+down",
        "mac": "cmd+alt+down",
        "when": "activeWebviewPanelId == 'bharatcode-agent.AgentManagerPanel'"
      },
      {
        "command": "bharatcode-agent.agentManager.previousTab",
        "key": "ctrl+alt+left",
        "mac": "cmd+alt+left",
        "when": "bharatcode-agent.sidebarFocused || activeWebviewPanelId == 'bharatcode-agent.TabPanel' || activeWebviewPanelId == 'bharatcode-agent.AgentManagerPanel'"
      },
      {
        "command": "bharatcode-agent.agentManager.nextTab",
        "key": "ctrl+alt+right",
        "mac": "cmd+alt+right",
        "when": "bharatcode-agent.sidebarFocused || activeWebviewPanelId == 'bharatcode-agent.TabPanel' || activeWebviewPanelId == 'bharatcode-agent.AgentManagerPanel'"
      },
      {
        "command": "bharatcode-agent.agentManager.previousTerminal",
        "key": "ctrl+shift+[",
        "mac": "cmd+shift+[",
        "when": "activeWebviewPanelId == 'bharatcode-agent.AgentManagerPanel'"
      },
      {
        "command": "bharatcode-agent.agentManager.nextTerminal",
        "key": "ctrl+shift+]",
        "mac": "cmd+shift+]",
        "when": "activeWebviewPanelId == 'bharatcode-agent.AgentManagerPanel'"
      },
      {
        "command": "bharatcode-agent.agentManager.search",
        "key": "ctrl+f",
        "mac": "cmd+f",
        "when": "activeWebviewPanelId == 'bharatcode-agent.AgentManagerPanel' && !terminalFocus"
      },
      {
        "command": "bharatcode-agent.agentManager.showTerminal",
        "key": "ctrl+/",
        "mac": "cmd+/",
        "when": "activeWebviewPanelId == 'bharatcode-agent.AgentManagerPanel' && !bharatcode-agent.sidebarFocused"
      },
      {
        "command": "bharatcode-agent.agentManager.runScript",
        "key": "ctrl+e",
        "mac": "cmd+e",
        "when": "activeWebviewPanelId == 'bharatcode-agent.AgentManagerPanel' && (isMac || !terminalFocus)"
      },
      {
        "command": "bharatcode-agent.agentManager.toggleDiff",
        "key": "ctrl+d",
        "mac": "cmd+d",
        "when": "activeWebviewPanelId == 'bharatcode-agent.AgentManagerPanel'"
      },
      {
        "command": "bharatcode-agent.agentManager.showShortcuts",
        "key": "ctrl+shift+/",
        "mac": "cmd+shift+/",
        "when": "activeWebviewPanelId == 'bharatcode-agent.AgentManagerPanel'"
      },
      {
        "command": "bharatcode-agent.agentManager.newTab",
        "key": "ctrl+t",
        "mac": "cmd+t",
        "when": "activeWebviewPanelId == 'bharatcode-agent.AgentManagerPanel' && !bharatcode-agent.agentManagerSideTerminalFocused"
      },
      {
        "command": "bharatcode-agent.agentManager.newTerminalTab",
        "key": "ctrl+shift+t",
        "mac": "cmd+shift+t",
        "when": "activeWebviewPanelId == 'bharatcode-agent.AgentManagerPanel' && !bharatcode-agent.agentManagerSideTerminalFocused"
      },
      {
        "command": "bharatcode-agent.agentManager.newSideTerminal",
        "key": "ctrl+t",
        "mac": "cmd+t",
        "when": "activeWebviewPanelId == 'bharatcode-agent.AgentManagerPanel' && bharatcode-agent.agentManagerSideTerminalFocused"
      },
      {
        "command": "bharatcode-agent.agentManager.closeTab",
        "key": "ctrl+w",
        "mac": "cmd+w",
        "when": "activeWebviewPanelId == 'bharatcode-agent.AgentManagerPanel'"
      },
      {
        "command": "bharatcode-agent.agentManager.newWorktree",
        "key": "ctrl+n",
        "mac": "cmd+n",
        "when": "activeWebviewPanelId == 'bharatcode-agent.AgentManagerPanel'"
      },
      {
        "command": "bharatcode-agent.agentManager.quickWorktree",
        "key": "ctrl+shift+n",
        "mac": "cmd+shift+n",
        "when": "activeWebviewPanelId == 'bharatcode-agent.AgentManagerPanel'"
      },
      {
        "command": "bharatcode-agent.agentManager.openWorktree",
        "key": "ctrl+shift+o",
        "mac": "cmd+shift+o",
        "when": "activeWebviewPanelId == 'bharatcode-agent.AgentManagerPanel'"
      },
      {
        "command": "bharatcode-agent.agentManager.openPR",
        "key": "ctrl+shift+r",
        "mac": "cmd+shift+r",
        "when": "activeWebviewPanelId == 'bharatcode-agent.AgentManagerPanel'"
      },
      {
        "command": "bharatcode-agent.agentManager.closeWorktree",
        "key": "ctrl+shift+w",
        "mac": "cmd+shift+w",
        "when": "activeWebviewPanelId == 'bharatcode-agent.AgentManagerPanel'"
      },
      {
        "command": "bharatcode-agent.agentManager.jumpTo1",
        "key": "ctrl+1",
        "mac": "cmd+1",
        "when": "activeWebviewPanelId == 'bharatcode-agent.AgentManagerPanel'"
      },
      {
        "command": "bharatcode-agent.agentManager.jumpTo2",
        "key": "ctrl+2",
        "mac": "cmd+2",
        "when": "activeWebviewPanelId == 'bharatcode-agent.AgentManagerPanel'"
      },
      {
        "command": "bharatcode-agent.agentManager.jumpTo3",
        "key": "ctrl+3",
        "mac": "cmd+3",
        "when": "activeWebviewPanelId == 'bharatcode-agent.AgentManagerPanel'"
      },
      {
        "command": "bharatcode-agent.agentManager.jumpTo4",
        "key": "ctrl+4",
        "mac": "cmd+4",
        "when": "activeWebviewPanelId == 'bharatcode-agent.AgentManagerPanel'"
      },
      {
        "command": "bharatcode-agent.agentManager.jumpTo5",
        "key": "ctrl+5",
        "mac": "cmd+5",
        "when": "activeWebviewPanelId == 'bharatcode-agent.AgentManagerPanel'"
      },
      {
        "command": "bharatcode-agent.agentManager.jumpTo6",
        "key": "ctrl+6",
        "mac": "cmd+6",
        "when": "activeWebviewPanelId == 'bharatcode-agent.AgentManagerPanel'"
      },
      {
        "command": "bharatcode-agent.agentManager.jumpTo7",
        "key": "ctrl+7",
        "mac": "cmd+7",
        "when": "activeWebviewPanelId == 'bharatcode-agent.AgentManagerPanel'"
      },
      {
        "command": "bharatcode-agent.agentManager.jumpTo8",
        "key": "ctrl+8",
        "mac": "cmd+8",
        "when": "activeWebviewPanelId == 'bharatcode-agent.AgentManagerPanel'"
      },
      {
        "command": "bharatcode-agent.agentManager.jumpTo9",
        "key": "ctrl+9",
        "mac": "cmd+9",
        "when": "activeWebviewPanelId == 'bharatcode-agent.AgentManagerPanel'"
      },
      {
        "command": "bharatcode-agent.cycleAgentMode",
        "key": "ctrl+.",
        "mac": "cmd+.",
        "when": "bharatcode-agent.sidebarFocused || activeWebviewPanelId == 'bharatcode-agent.AgentManagerPanel' || activeWebviewPanelId == 'bharatcode-agent.TabPanel'"
      },
      {
        "command": "bharatcode-agent.cyclePreviousAgentMode",
        "key": "ctrl+shift+.",
        "mac": "cmd+shift+.",
        "when": "bharatcode-agent.sidebarFocused || activeWebviewPanelId == 'bharatcode-agent.AgentManagerPanel' || activeWebviewPanelId == 'bharatcode-agent.TabPanel'"
      },
      {
        "command": "bharatcode-agent.settingsSearch",
        "key": "ctrl+f",
        "mac": "cmd+f",
        "when": "activeWebviewPanelId == 'bharatcode-agent.settingsPanel'"
      }
    ],
